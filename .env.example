# Database connection (PostgreSQL via psycopg)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/multi_ai_agent

# Qdrant vector database (local Qdrant by default; use the Cloud URL/key in production)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ecommerce_support

# Auth cookie: keep true in production; set false only for local HTTP development
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=none

# Allowed frontend origin in production (e.g. https://your-site.vercel.app)
FRONTEND_URL=

# Ollama Cloud OpenAI-compatible API (required for chat)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b-cloud

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-ai-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
